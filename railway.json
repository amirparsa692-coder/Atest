{
  "$schema": "https://railway.app/industry-standard-schema.json",
  "deploy": {
    "startCommand": "python -m uvicorn panel.main:app --host 0.0.0.0 --port $PORT --proxy-headers --forwarded-allow-ips=\"*\"",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
